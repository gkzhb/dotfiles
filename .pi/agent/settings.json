{
  "lastChangelogVersion": "0.99.1",
  "defaultProvider": "newapi",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "showHardwareCursor": true,
  "theme": "dark",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-goal",
    "npm:pi-metrics",
    "npm:pi-copy-message",
    "npm:pi-background-tasks",
    "npm:pi-custom-system-prompt",
    "npm:@furbyhaxx/pi-session-naming",
    "npm:@fitchmultz/pi-stash"
  ],
  "session": {
    "titleGeneration": {
      "enabled": true,
      "language": "auto",
      "model": "MiniMax-M3",
      "retries": 3,
      "emojis": false,
      "maxLength": 52,
      "scopeMaxLength": 12,
      "maxMessageCount": -1,
      "includeTools": true,
      "useTags": true,
      "builtinTags": true,
      "tags": []
    },
    "browser": {
      "enabled": true,
      "command": "sessions",
      "pageSize": 12,
      "delete": {
        "enabled": true,
        "useTrash": true,
        "confirmPresses": 2
      }
    },
    "rename": {
      "enabled": true,
      "command": "rename",
      "interactiveWhenEmpty": true
    }
  },
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "MiniMax-M3"
      },
      "worker": {
        "model": "gpt-6.1-sol"
      }
    }
  },
  "outputPad": 0,
  "tuiMode": "fullscreen"
}
